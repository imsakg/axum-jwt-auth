DATABASE_URL=postgres://auth:auth-local-only@127.0.0.1:5432/auth
# Development example only. Replace with at least 32 random bytes in deployment.
JWT_SECRET=development-only-replace-with-a-random-secret
# For rotation, set a JSON object mapping key IDs to strong secrets and select one:
# JWT_KEYS={"default":"replace-with-a-high-entropy-secret-of-32-bytes-or-more"}
# JWT_ACTIVE_KID=default
JWT_ISSUER=axum-jwt-auth
JWT_AUDIENCE=axum-jwt-clients
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
BIND_ADDRESS=127.0.0.1:8000
